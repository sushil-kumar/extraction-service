# Stage 1: Build/Download the model
FROM ollama/ollama:0.34.2 AS builder

# Start Ollama server in the background, wait for it to start, then pull the model
RUN nohup ollama serve > /tmp/ollama.log 2>&1 & \
    sleep 10 && \
    ollama pull qwen2.5vl:7b

# Stage 2: Final lightweight runtime image
FROM  ollama/ollama:0.34.2

# Copy the preloaded model data from the builder stage
COPY --from=builder /root/.ollama /root/.ollama

# Expose the default Ollama API port
EXPOSE 11434

# Set the default command to run the server
CMD ["serve"]